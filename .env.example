# ReliefStock AI - Environment Configuration Template
# Copy this file to .env for local development, or set these keys in Agentverse Secrets.

# ASI:One API Key for natural language understanding and intent classification
ASI1_API_KEY=your_asi1_api_key_here

# Optional: Custom ASI:One endpoint (defaults to https://api.asi1.ai/v1)
# ASI1_BASE_URL=https://api.asi1.ai/v1

# Optional: Google Maps API Key for verified road routing and traffic (falls back to OSRM if omitted)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
